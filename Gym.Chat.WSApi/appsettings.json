{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Cors": "Information",
      "Microsoft.AspNetCore.SignalR": "Information",
      "Microsoft.AspNetCore.Http.Connections": "Information"
    }
  },
  "AllowedHosts": "*",
  "CorsOrigins": [ "https://localhost:7092" ],
  "Redis": {
    "ConnectionString": "localhost:6379,defaultDatabase=0",
    "KeyPrefix": "gym-chat:"
  },
  "AudienceUri": "urn:gym:api",
  "AccessTokenIssuer": "https://localhost:7218",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "DatabaseName": "chat"
  },
  "AuthorizationServer": {
    "ClientName": "auth-server",
    "BaseUrl": "https://localhost:7218",
    "AuthorizeEndpoint": "authorize",
    "TokenEndpoint": "token",
    "UserInfoEndpoint": "userinfo",
    "JwksEndpoint": ".well-known/jwks.json",
    "Kid": "gym_auth_key"
  },
  "RabbitMQ": {
    "Hostname": "localhost",
    "Username": "guest",
    "Password": "guest",
    "Vhost": "/"
  },
  "AuthenticationCookie": {
    "Name": "__Host-Gym.BFF.Client",
    "DataProtectorPurpose": "Gym.Cookies"
  }
}
