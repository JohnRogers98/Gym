@page
@model Gym.AuthorizationServer.Pages.LoginModel
@{
    Layout = "_Layout";
}

<div style="width: 100%; max-width: 400px; padding: 20px;">
    <div class="card">
        <div class="card-content">
            <span class="card-title center-align">Enter</span>

            <form method="post">
                <div class="row">
                    <div class="col s12">
                        <div class="input-field">
                            <input asp-for="Username" type="text" class="validate" required />
                            <label asp-for="Username">Username</label>
                            <span asp-validation-for="Username" class="red-text"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col s12">
                        <div class="input-field">
                            <input asp-for="Password" type="password" class="validate" required />
                            <label asp-for="Password">Password</label>
                            <span asp-validation-for="Password" class="red-text"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col s12">
                        <button class="btn waves-effect waves-light full-width" type="submit" style="width: 100%;">Submit</button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>
