{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClientCredentials": {
    "ClientId": "65a3b5c7d8e9f0123456789a",
    "ClientSecret": "client_secret",
    "RedirectUri": "https://localhost:7222/callback",
    "Scope": "openid profile"
  },
  "Urls": {
    "AuthorizationServer": {
      "ClientName": "auth-server",
      "BaseUrl": "https://localhost:7218",
      "AuthorizeEndpoint": "/authorize",
      "TokenEndpoint": "/token",
      "UserInfoEndpoint": "/userinfo",
      "JwksEndpoint": "/.well-known/jwks.json",
      "Kid": "gym_auth_key"
    },
    "AuthorizationServerAdminApi": {
      "ClientName": "auth-server-admin",
      "BaseUrl": "https://localhost:7193"
    },
    "Bff": {
      "BaseUrl": "",
      "CallbackPath": "/callback",
      "LoginPath": "/login",
      "LogoutPath": "/logout"
    },
    "Spa": {
      "BaseUrl": "https://localhost:7092",
      "CallbackEndpoint": "/login-callback"
    }
  },
  "ResourceUris": {
    "Api": "urn:gym:api"
  }, 
  "StaticHeaderCheck": {
    "Enabled": true,
    "ExcludedPaths": [ "/login", "/callback", "/logout" ]
  }
}
