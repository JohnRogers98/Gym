{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MongodDb": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "DatabaseName": "my-test-db",
    "CollectionOptions": {
      "Instructors": "instructors",
      "InstructorProjections": "instructor-projections",
      "Trainings": "trainings",
      "TrainingProjections": "training-projections",
      "CalendarEvents": "calendar-events",
      "CalendarEventProjections": "calendar-event-projections",
      "Users": "users",
      "TelegramAuths": "telegram-auths",
      "FormAuths": "form-auths",
      "Clients": "clients",
      "ClientProjections": "client-projections",
      "Events": "events",
      "EventProjections": "event-projections",
      "Messages": "messages",
      "OutboxChangeStreams": "outbox-changes-streams",
      "Polls": "polls",
      "PollResponses": "poll-responses",
      "PersonalTrainings": "personal-trainings",
      "PersonalTrainingProjections": "personal-training-projections"
    }
  },
  "BffUrl": "https://localhost:7222",
  "AuthorizationServer": {
    "ClientName": "auth-server",
    "BaseUrl": "https://localhost:7218",
    "AuthorizeEndpoint": "/authorize",
    "TokenEndpoint": "/token",
    "UserInfoEndpoint": "/userinfo",
    "JwksEndpoint": "/.well-known/jwks.json",
    "Kid": "gym_auth_key"
  },
  "RabbitMQ": {
    "Hostname": "localhost",
    "Username": "guest",
    "Password": "guest",
    "Exchange": "auth-events-x"
  },
  "AudienceUri": "urn:gym:api",
  "AccessTokenIssuer": "https://localhost:7218"
}
