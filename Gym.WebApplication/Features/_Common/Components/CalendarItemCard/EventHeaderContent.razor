@using System.Globalization
@using Gym.WebApplication.Features._Common.Components
@using Gym.WebDto.Responses.Instructor

<MudStack Spacing="3">
    <MudText Typo="Typo.h6" Class="text-truncate">@Title</MudText>
    <MudText Color="Color.Default" Typo="Typo.body2">
        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Primary" Size="Size.Small" />
        @Start.ToString("HH:mm") @(End.HasValue ? End?.ToString("HH:mm") : String.Empty)
    </MudText>
</MudStack>

@code{
    [Parameter, EditorRequired] public String Title { get; set; } = default!;
    [Parameter, EditorRequired] public DateTime Start { get; set; } = default!;
    [Parameter] public DateTime? End { get; set; }
}