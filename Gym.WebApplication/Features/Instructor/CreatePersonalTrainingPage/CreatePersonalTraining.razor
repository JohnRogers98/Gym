@page "/create-personal-training"
@using Gym.WebApplication.Features.Instructor.CreatePersonalTrainingPage.Models
@using Gym.WebApplication.Features.Instructor.CreatePersonalTrainingPage.Models.Forms
@using Gym.WebApplication.Features.Instructor.CreatePersonalTrainingPage.Models.Results
@using Gym.WebApplication.Features.Instructor.CreatePersonalTrainingPage.Services
@using Gym.WebApplication.Features._Common.Services
@using Gym.WebApplication.Features._Common.States

@inject IRequestHandler<GetAllClientsForInstructor, IEnumerable<ClientViewModel>> GetAllClientsService
@inject IRequestHandler<CreatePersonalTrainingFormModel, CreatePersonalTrainingResult> CreatePersonalTrainingService

@inject IAppSnackbarNotifier SnackbarNotifier

<MudContainer>

    <EditForm Model="@_formModel" OnValidSubmit="@OnValidSubmit">
    
        <DataAnnotationsValidator />

        <MudCard Elevation="3">

            <MudCardHeader Class="d-flex justify-center align-center">
                <MudText Typo="Typo.h5">Create personal training</MudText>
            </MudCardHeader>

            <MudCardContent>
                <MudStack Spacing="3">

                    <MudSelect T="String" @bind-Value="@_formModel.ClientId" Variant="Variant.Outlined" Clearable="true" Label="Choose client" For="@(() => _formModel.ClientId)">
                        @foreach (var client in _clients)
                        {
                            <MudSelectItem T="String" Value="@client.Id">
                                @client.FullName
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" Label="Choose day" AutoClose="true"
                                   MinDate="@DateTime.Today" @bind-Date="@_formModel.LocalStartDateTime" For="@(() => _formModel.LocalStartDateTime)" />

                    <MudTimePicker PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" Label="Choose time" AutoClose="true"
                                   @bind-Time="@_formModel.StartTimeSpan" For="@(() => _formModel.StartTimeSpan)" />
                    
                    <MudNumericField @bind-Value="@_formModel.DurationInMinutes" Label="Choose duration in minutes" Variant="Variant.Outlined"
                                     Step="15" For="@(() => _formModel.DurationInMinutes)" />

                    <MudTextField @bind-Value="@_formModel.InstructorComment" Label="Your comment" Variant="Variant.Outlined" For="@(() => _formModel.InstructorComment)" />

                    <MudCheckBox @bind-Value="@_formModel.IsPaid" Label="Is payed?" Color="Color.Primary"></MudCheckBox>

                </MudStack>
            </MudCardContent>

            <MudCardActions>
                <MudStack Row="true" Class="ml-auto">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Create</MudButton>
                </MudStack>
                  
            </MudCardActions>
        </MudCard>

    </EditForm>

</MudContainer>

@code {
    private CreatePersonalTrainingFormModel _formModel = new();

    private IList<ClientViewModel> _clients = [];

    protected override async Task OnInitializedAsync()
    {
        await this.LoadDataAsyn();
    }

    private async void OnValidSubmit(EditContext context)
    {
        var createPersonalTrainingResult = await CreatePersonalTrainingService.HandleAsync(_formModel);
        if (createPersonalTrainingResult.Succeeded)
        {
            SnackbarNotifier.ShowMessage($"Personal training - {createPersonalTrainingResult.Data!.PersonalTrainingId} created.", MessageSeverity.Success);
            this.ClearForm();
        }
    }

    private async Task LoadDataAsyn()
    {
        var getAllClientsResult = await GetAllClientsService.HandleAsync(new GetAllClientsForInstructor());
        if (getAllClientsResult.Succeeded)
            _clients = [.. getAllClientsResult.Data!];
    }

    private void ClearForm()
    {
        _formModel = new();
        base.StateHasChanged();
    }
}
