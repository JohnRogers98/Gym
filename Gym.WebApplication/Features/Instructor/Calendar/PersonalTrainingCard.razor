@using System.Globalization
@using Gym.WebApplication.Features._Common.Components
@using Gym.WebApplication.Features._Common.Components.CalendarItemCard
@using Gym.WebDto.Responses.Instructor

@inject IDialogService DialogService

<MudCard Outlined="false" Elevation="3">

    <CalendarItemCardHeader Title="@("Personal training")" Start="PersonalTraining.Start" End="@PersonalTraining.End">
        
        <MenuContent>
            <MudMenu Icon="@Icons.Material.Filled.Settings"
                     Color="Color.Primary"
                     AriaLabel="Actions">
                <MudDivider />
                <MudMenuItem Disabled="@PersonalTraining.IsCancelled" Label="@(@PersonalTraining.IsCancelled ? "Cancelled" : "Cancel")" OnClick="@CancelTrainingAsync" />
            </MudMenu>
        </MenuContent>

    </CalendarItemCardHeader>

    <MudDivider />

    <MudCardContent>
        <MudStack>

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.PersonPin" Color="Color.Primary" Size="Size.Small" />
                <MudText>@PersonalTraining.Client.FullName</MudText>
            </MudStack>

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Payment" Color="Color.Primary" Size="Size.Small" />
                @if (PersonalTraining.IsPaid)
                {
                    <MudChip T="String" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Text="Yes" />
                }
                else
                {
                    <MudChip T="String" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Text="No" />
                }
            </MudStack>

        </MudStack>
    </MudCardContent>

</MudCard>    
    

@code {
    [Parameter, EditorRequired] public PersonalTrainingViewModel PersonalTraining { get; set; } = default!;

    private async Task CancelTrainingAsync()
    {
        Console.WriteLine(PersonalTraining.Status);
        var parameters = new DialogParameters<CancelPersonalTrainingDialog> { { x => x.PersonalTraining, PersonalTraining } };

        var dialog = await DialogService.ShowAsync<CancelPersonalTrainingDialog>("Cancelling training", parameters);
        var result = await dialog.Result;

        if(result!.Canceled is false)
        {
            PersonalTraining = PersonalTraining with { Status = "Cancelled" };
            base.StateHasChanged();
        }
    }
}