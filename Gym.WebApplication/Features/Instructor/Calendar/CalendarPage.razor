@page "/instructor-calendar"
@using Gym.WebApplication.Features.Instructor.Calendar.Services
@using Gym.WebApplication.Features._Common
@using Gym.WebApplication.Features._Common.Components
@using Gym.WebApplication.Features._Common.Services

@attribute [Authorize(Roles = "Instructor")]

@inject IRequestHandler<GetInstructorCalendarEvents, IEnumerable<CalendarEventForAdminViewModel>> GetCalendarEventsService
@inject IRequestHandler<GetInstructorPersonalTrainings, IEnumerable<PersonalTrainingViewModel>> GetPersonalTrainingsService

<DatePicker OnDatePicked="@DatePicked"></DatePicker>

<MudContainer>
    <MudGrid Spacing="3">
        @foreach (var aCalendarItem in _pickedCalendarItems)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                @if (aCalendarItem is CalendarEventForAdminViewModel calendarEvent)
                {
                <CalendarEventCard CalendarEvent="@calendarEvent"></CalendarEventCard>
                }
                else if (aCalendarItem is PersonalTrainingViewModel personalTraining)
                {
                <PersonalTrainingCard PersonalTraining="@personalTraining"></PersonalTrainingCard>
                }
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private List<CalendarEventForAdminViewModel> _calendarEvents = new();
    private List<PersonalTrainingViewModel> _personalTrainings = new();

    private List<ITimeBasedItem> _pickedCalendarItems = new();

    private DateOnly _pickedDate = default;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        if (_calendarEvents.Any() || _personalTrainings.Any())
        {
            this.DatePicked(DateTime.Today.ToDateOnly());
            _pickedDate = DateTime.Today.ToDateOnly();
        }
    }

    private void DatePicked(DateOnly pickedDate)
    {
        _pickedDate = pickedDate;

        _pickedCalendarItems = _calendarEvents
            .Where(calendarEvent => calendarEvent.Start.ToDateOnly() == pickedDate)
            .Cast<ITimeBasedItem>()
            .Concat(_personalTrainings
                .Where(personalTraining => personalTraining.Start.ToDateOnly() == pickedDate)
                .Cast<ITimeBasedItem>())
            .OrderBy(item => item.Start)
            .ToList();
    }

    private async Task LoadDataAsync()
    {
        var getCalendarEventsResult = await GetCalendarEventsService.HandleAsync(new GetInstructorCalendarEvents());
        if (getCalendarEventsResult.Succeeded)
            _calendarEvents = [.. getCalendarEventsResult.Data!];

        var getPersonalTrainingsResult = await GetPersonalTrainingsService.HandleAsync(new GetInstructorPersonalTrainings());
        if (getPersonalTrainingsResult.Succeeded)
            _personalTrainings = [.. getPersonalTrainingsResult.Data!];
    }
}
