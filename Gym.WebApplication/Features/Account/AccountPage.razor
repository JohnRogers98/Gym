@page "/account"
@using Gym.WebApplication.Features.Account.Services
@using Gym.WebApplication.Features.Account.ViewModels
@using Gym.WebDto.Responses.Account

@attribute [Authorize(Roles = "Client")]

@inject IGetAllAccountHistoryItemsService GetAllAccountHistoryItemsService

@if (_historyItems is null)
{
    <MudSkeleton />
}
else
{
    <MudContainer>
    <MudGrid Spacing="3">
            <MudTimeline TimelinePosition="TimelinePosition.Start">

                @foreach (var aHistoryItem in _historyItems)
                {
                    <MudTimelineItem Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                        <ItemContent>
                            <MudCard Outlined="true" Elevation="25">
                                <MudCardContent>
                                    <MudText Typo="Typo.body2">@aHistoryItem.GetMessage()</MudText>
                                    <MudText Typo="Typo.body2">@aHistoryItem.OccurredAt.ToDateOnly()</MudText>
                                </MudCardContent>
                            </MudCard>
                        </ItemContent>

                    </MudTimelineItem>
                }
            </MudTimeline>

    </MudGrid>
</MudContainer>
   
}

@code {

    public List<AccountHistoryItemViewModel> _historyItems = default!;

    protected override async Task OnInitializedAsync()
    {
        var loadedHistoryItems = await GetAllAccountHistoryItemsService.ExecuteAsync();
        _historyItems = new List<AccountHistoryItemViewModel>(loadedHistoryItems);
    }
}
