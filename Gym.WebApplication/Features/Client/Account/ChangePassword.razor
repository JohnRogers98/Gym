@using Gym.WebApplication.Features._Common.Services

@inject IRequestHandler<ChangePasswordFormModel, ChangePasswordResult> ChangePasswordService
@inject NavigationManager NavManager

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<ChangePasswordFormModel, ChangePasswordResult> ChangePasswordState

@inject IDialogService DialogService

@implements IDisposable

<MudCard Outlined="false" Elevation="3">

    <MudCardContent>
        <EditForm Model="@_formModel" OnSubmit="@OnSubmit">

            <FluentValidator AsyncMode="false" />

            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="12">
                    <MudCard Elevation="0">
                        <MudCardContent>
                            <MudTextField Label="Current password"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          @bind-Value="@_formModel.CurrentPassword"
                                          For="@(() => _formModel.CurrentPassword)" />

                            <MudTextField Label="New password"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Password"
                                          Class="mt-3"
                                          @bind-Value="_formModel.NewPassword"
                                          For="@(() => _formModel.NewPassword)" />
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton ButtonType="ButtonType.Submit" Disabled="@_isSubmitting" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">
                                @(_isSubmitting ? "Changing..." : "Change")
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudCardContent>

</MudCard>

@code {
    private ChangePasswordFormModel _formModel = new();

    private Boolean _isSubmitting;

    protected async override Task OnInitializedAsync()
    {
        ChangePasswordState.Executed += this.ShowInSnackbar;
    }

    private async Task OnSubmit(EditContext context)
    {
        var isValid = context.Validate();
        if (isValid)
        {
            await this.ChangePasswordAsync();
        }
        NavManager.NavigateTo("/");
    }

    private async Task ChangePasswordAsync()
    {
        //guard
        if (_isSubmitting) return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var changePasswordResult = await ChangePasswordService.HandleAsync(_formModel);
            if (changePasswordResult.Succeeded)
            {
                this.ClearForm();
            }
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private void ClearForm()
    {
        _formModel = new();
        base.StateHasChanged();
    }

    private void ShowInSnackbar(AsyncOperation<ChangePasswordResult> passwordChangingResult)
    {
        if (passwordChangingResult.Succeeded)
        {
            SnackbarNotifier.ShowMessage($"Password changed.", MessageSeverity.Success);
        }
    }

    public void Dispose() => ChangePasswordState.Executed -= this.ShowInSnackbar;
}
