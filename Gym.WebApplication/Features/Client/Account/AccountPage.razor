@page "/account"
@using Gym.WebApplication.Features.Client.Account.ChangePassword
@using Gym.WebApplication.Features.Client.Account.Details
@using Gym.WebApplication.Features.Client.Account.History

@attribute [Authorize(Roles = "Client")]

<MudContainer>
    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="false">
        <div class="d-flex flex-column align-center gap-3">
            <MudTabs Class="mx-4" Rounded="true" ActiveTabClass="border-solid border-2 mud-border-primary" PanelClass="pt-10 px-4">

                <MudTabPanel Text="Details">
                    <AccountDetails></AccountDetails>
                </MudTabPanel>

                <MudTabPanel Text="History">
                    <AccountHistory></AccountHistory>
                </MudTabPanel>

                <MudTabPanel Text="Password">
                    <ChangePassword></ChangePassword>
                </MudTabPanel>

            </MudTabs>
        </div>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
        <MudTabs Class="mx-4" Rounded="true" ActiveTabClass="border-solid border-2 mud-border-primary" PanelClass="pt-10">

            <MudTabPanel Text="Details">
                <AccountDetails></AccountDetails>
            </MudTabPanel>

            <MudTabPanel Text="History">
                <AccountHistory></AccountHistory>
            </MudTabPanel>

            <MudTabPanel Text="Password">
                <ChangePassword></ChangePassword>
            </MudTabPanel>

        </MudTabs>
    </MudHidden>
</MudContainer>



