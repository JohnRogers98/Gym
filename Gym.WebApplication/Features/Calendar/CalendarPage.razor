@page "/calendar"
@using Gym.WebApplication.Features.Calendar.Models
@using Gym.WebApplication.Features.Calendar.Services
@using System.Collections.ObjectModel
@using System.Collections.Specialized

@attribute [Authorize(Roles = "Client")]

@inject IGetAllCalendarItemsService GetAllCalendarItemsService
@inject IBookCalendarItemService BookCalendarItemService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService

@if (_calendarItems is null)
{
    <MudSkeleton />
}
else
{
    <Picker OnDatePicked="@this.DatePicked"></Picker>
    
    <ItemsContainer CalendarItems="@_selectedItems" OnSelectedCalendarItem="@this.BookEvent"></ItemsContainer>
}


@code {
    private List<ClientCalendarItemViewModel> _calendarItems = default!;

    private List<ClientCalendarItemViewModel> _selectedItems = default!;

    private DateOnly? _pickedDate = default; 

    protected override async Task OnInitializedAsync()
    {
        var loadedCalendarEvents = await GetAllCalendarItemsService.HandleAsync();
        _calendarItems = new List<ClientCalendarItemViewModel>(loadedCalendarEvents);

        _pickedDate = DateTime.Now.ToDateOnly();
        this.RefreshSelectedItems();
    }

    private void DatePicked(DateOnly pickedDate)
    {
        _pickedDate = pickedDate;
        this.RefreshSelectedItems();
        base.StateHasChanged();
    }

    private async void BookEvent(ClientCalendarItemViewModel selectdCalendarEvent)
    {
        PollResponse? pollResponse = null;
        if (selectdCalendarEvent.Poll is not null)
        {
            var parameters = new DialogParameters<SubmitPollDialog> { { x => x.PollViewModel, selectdCalendarEvent.Poll } };

            var dialog = await DialogService.ShowAsync<SubmitPollDialog>("Response poll", parameters);
            var result = await dialog.Result;

            if (result!.Canceled)
            {
                return;
            }

            if (result?.Data is PollResponse shapedResponse)
                pollResponse = shapedResponse;
        }

        Boolean bookingSuccessful = await BookCalendarItemService.HandleAsync(selectdCalendarEvent, pollResponse);
        if (bookingSuccessful)
        {
            var indexOfEvent = _calendarItems.IndexOf(selectdCalendarEvent);
            if (indexOfEvent >= 0)
            {
                var eventWithUpdatedBookingStatus = selectdCalendarEvent with
                {
                    IsAlreadyBooked = true,
                    CurrentClientCount = selectdCalendarEvent.CurrentClientCount + 1
                };

                _calendarItems[indexOfEvent] = eventWithUpdatedBookingStatus;
                this.RefreshSelectedItems();
            }

            base.StateHasChanged();
        }
        else
        {
            Console.WriteLine("Booking status error.");
        }
    }

    private void RefreshSelectedItems() => _selectedItems = new(_calendarItems.Where(aCalendarEvent => aCalendarEvent.UtcStart.ToDateOnly() == _pickedDate));
}
