@page "/calendar"
@using Gym.WebApplication.Features.Calendar.Services
@using System.Collections.ObjectModel
@using System.Collections.Specialized

@attribute [Authorize]

@inject ICalendarService CalendarService
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (_calendarItems is null)
{
    <MudSkeleton />
}
else
{
    <Picker OnDatePicked="@this.DatePicked"></Picker>
    
    <ItemsContainer CalendarItems="@_selectedItems" OnSelectedCalendarItem="@this.BookEvent"></ItemsContainer>
}


@code {
    private List<CalendarItemViewModel> _calendarItems = default!;

    private List<CalendarItemViewModel> _selectedItems = default!;

    private DateOnly? _pickedDate = default; 

    protected override async Task OnInitializedAsync()
    {
        var loadedCalendarEvents = await CalendarService.GetAllCalendarItemsAsync();
        _calendarItems = new List<CalendarItemViewModel>(loadedCalendarEvents);

        _pickedDate = DateTime.Now.ToDateOnly();
        this.RefreshSelectedItems();
    }

    private void DatePicked(DateOnly pickedDate)
    {
        _pickedDate = pickedDate;
        this.RefreshSelectedItems();
        base.StateHasChanged();
    }

    private async void BookEvent(CalendarItemViewModel selectdCalendarEvent)
    {
        Boolean bookingSuccessful = await CalendarService.BookCalendarItem(selectdCalendarEvent);
        if (bookingSuccessful)
        {
            var indexOfEvent = _calendarItems.IndexOf(selectdCalendarEvent);
            if (indexOfEvent >= 0)
            {
                var eventWithUpdatedBookingStatus = selectdCalendarEvent with
                {
                    IsAlreadyBooked = true,
                    CurrentClientCount = selectdCalendarEvent.CurrentClientCount + 1
                };

                _calendarItems[indexOfEvent] = eventWithUpdatedBookingStatus;
                this.RefreshSelectedItems();
            }

            base.StateHasChanged();
        }
        else
        {
            Console.WriteLine("Booking status error.");
        }
    }

    private void RefreshSelectedItems() => _selectedItems = new(_calendarItems.Where(aCalendarEvent => aCalendarEvent.Start.ToDateOnly() == _pickedDate));
}
