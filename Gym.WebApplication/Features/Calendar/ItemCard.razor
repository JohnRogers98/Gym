@using System.Globalization
@using Gym.WebApplication.Features._Common
@using Gym.WebDto.Responses.Instructor

<MudCard Outlined="false" Elevation="3">

    <MudCardHeader>
        <CardHeaderAvatar>
            <div style="display: flex; flex-direction: column; align-items: center;">
                <MudAvatar Size="Size.Large" Color="Color.Primary" Class="mb-1">
                    @CalendarItem.UtcStart.Day
                </MudAvatar>
                <MudText Color="Color.Primary" Typo="Typo.caption" Class="mt-1">
                    @this.GetMonthText()
                </MudText>
            </div>
        </CardHeaderAvatar>

        <CardHeaderContent>
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6" Class="text-truncate">
                    @CalendarItem.Training.Name
                </MudText>
                <MudText Color="Color.Default" Typo="Typo.body2">
                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Primary" Size="Size.Small" />
                    @CalendarItem.LocalStart.ToString("HH:mm") - @CalendarItem.LocalEnd?.ToString("HH:mm")
                </MudText>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudDivider />

    <MudCardContent>
        <MudStack>
            <MudText>@CalendarItem.Training.Description</MudText>

            @if (CalendarItem.Instructors?.Any() == true)
            {
                <MudList T="InstructorDto" Dense="true" Gutters="false">
                    @foreach (var instructor in CalendarItem.Instructors)
                    {
                        <MudListItem>
                            <MudIcon Icon="@Icons.Material.Filled.Person"
                                     Size="Size.Small" />
                            @instructor.FullName
                        </MudListItem>
                    }
                </MudList>
            }

            @if (CalendarItem.MaxClientCount.HasValue)
            {
                <MudProgressLinear Color="Color.Tertiary" Size="Size.Medium" Min="0" Max="@CalendarItem.MaxClientCount.Value" Value="@CalendarItem.CurrentClientCount" />
            }

            @if (CalendarItem.Poll is not null)
            {
                <Expander ExpandTitle="Show Poll" CollapseTitle="Hide Poll">
                    <PollInfo PollViewModel="@CalendarItem.Poll"></PollInfo>
                </Expander>
            }
        </MudStack>
    </MudCardContent>

    <MudCardActions>
        @if (CalendarItem.Status == "Cancelled")
        {
        <MudButton FullWidth="true"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="true">
            Отменено
        </MudButton>
        }
        else if(CalendarItem.IsAlreadyBooked)
        {
            <MudButton FullWidth="true"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="true">
                Вы уже записаны
            </MudButton>
        }
        else if (CalendarItem.IsFull())
        {
            <MudButton FullWidth="true"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="true">
                Мест нет
            </MudButton>
        }
        else
        {
            <MudButton FullWidth="true"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@(async (_) => await OnSelected.InvokeAsync(CalendarItem))">
                Записаться
            </MudButton>
        }
    </MudCardActions>

</MudCard>    
    

@code {
    [Parameter, EditorRequired] public ClientCalendarItemViewModel CalendarItem { get; set; } = default!;
    
    [Parameter] public EventCallback<ClientCalendarItemViewModel> OnSelected { get; set; }

    private String GetMonthText() => CalendarItem.UtcStart.ToString("MMM");
}