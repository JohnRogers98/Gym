
<MudAppBar Color="Color.Primary" Fixed="true">

    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => ToggleDrawer())" />

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            <MudMenuItem Href="/"
                         Icon="@Icons.Material.Filled.Home"
                         IconColor="Color.Primary"
                         Label="Home"
                         OnClick="@ToggleDrawer"/>

            <AuthorizeView>
                <NotAuthorized>
                    <MudMenuItem Href="/form-auth"
                                 Icon="@Icons.Material.Filled.Login"
                                 IconColor="Color.Primary"
                                 Label="Authorization"
                                 OnClick="@ToggleDrawer" />
                </NotAuthorized>
            </AuthorizeView>

            <AuthorizeView Roles="Client">

                <MudMenuItem Href="/client-calendar"
                             Icon="@Icons.Material.Filled.DateRange"
                             IconColor="Color.Primary"
                             Label="Calendar"
                             OnClick="@ToggleDrawer" />

                <MudMenuItem Href="/account"
                             Icon="@Icons.Material.Filled.AccountBalanceWallet"
                             IconColor="Color.Primary"
                             Label="Account"
                             OnClick="@ToggleDrawer" />

            </AuthorizeView>
          
            <AuthorizeView Roles="Admin">

                <MudMenuItem Href="/admin"
                             Icon="@Icons.Material.Filled.Edit"
                             IconColor="Color.Primary"
                             Label="Administration"
                             OnClick="@ToggleDrawer" />

            </AuthorizeView>

            <AuthorizeView Roles="Instructor">

                <MudMenuItem Href="/instructor-calendar"
                             Icon="@Icons.Material.Filled.DateRange"
                             IconColor="Color.Primary"
                             Label="Calendar"
                             OnClick="@ToggleDrawer" />

                <MudMenuItem Href="/create-personal-training"
                             Icon="@Icons.Material.Filled.PersonAdd"
                             IconColor="Color.Primary"
                             Label="Create personal training"
                             OnClick="@ToggleDrawer" />

            </AuthorizeView>
           
        </MudNavMenu>
      
    </MudDrawer>
  

    <MudSpacer></MudSpacer>

    <MockedWebAppLogin></MockedWebAppLogin>
    <MockedAdminLogin></MockedAdminLogin>
</MudAppBar>

@code {
    bool _drawerOpen = false;

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
