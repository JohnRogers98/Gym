
<MudAppBar Color="Color.Primary" Fixed="false">

    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => ToggleDrawer())" />

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            <MudMenuItem Href="/"
                         Icon="@Icons.Material.Filled.Home"
                         IconColor="Color.Primary"
                         Label="Home"
                         OnClick="@ToggleDrawer"/>

            <MudMenuItem Href="/calendar"
                         Icon="@Icons.Material.Filled.DateRange"
                         IconColor="Color.Primary"
                         Label="Calendar"
                         OnClick="@ToggleDrawer" />

            <MudMenuItem Href="/account"
                         Icon="@Icons.Material.Filled.AccountBalanceWallet"
                         IconColor="Color.Primary"
                         Label="Account"
                         OnClick="@ToggleDrawer" />
        </MudNavMenu>
      
    </MudDrawer>
  

    <MudSpacer></MudSpacer>

    <MockedWebAppLogin></MockedWebAppLogin>
    <MockedAdminLogin></MockedAdminLogin>
</MudAppBar>

@code {
    bool _drawerOpen = false;

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
