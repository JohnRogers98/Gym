@using Gym.WebApplication.Features.Login.Services

@inject IWebAppAuthService WevAppAuthService

<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Login" Color="Color.Primary" OnClick="Authenticate">Login</MudButton>

@code {

    private async void Authenticate()
    {
        await WevAppAuthService.Authenticate(MockedWebAppInitData.Value);
    }

}
