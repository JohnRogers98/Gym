@using Gym.WebApplication.Authentication

@inject ITelegramInitService TelegramInitService
@inject AuthStateProvider AuthStateProvider


<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Login" Color="Color.Primary" OnClick="Authenticate">Mocked tg login</MudButton>

@code {
    private async Task Authenticate()
    {
        await TelegramInitService.HandleAsync(MockedWebAppInitData.Value);
        await AuthStateProvider.ReloadAsync();
    }
}
