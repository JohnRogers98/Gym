@using Gym.WebApplication.Features.Login.Services

@inject IMockedAdminAuthService MockedAdminAuth

<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Login" Color="Color.Primary" OnClick="Authenticate">Admin Login</MudButton>

@code {

    private async void Authenticate()
    {
        await MockedAdminAuth.HandleAsync();
    }

}
