@using Gym.WebApplication.Authentication

@inject ILogoutService LogoutService
@inject UserAuthState UserAuthState

<AuthorizeView>

    <Authorized>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Logout" Color="Color.Primary" OnClick="LogoutAsync">Logout</MudButton>
    </Authorized>

</AuthorizeView>

@code {
    private async Task LogoutAsync()
    {
        await LogoutService.HandleAsync();
        UserAuthState.CurrentUser = new();
    }
}
