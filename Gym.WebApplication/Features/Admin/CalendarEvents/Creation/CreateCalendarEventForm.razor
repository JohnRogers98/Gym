@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation.Models.Forms
@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation.Models.Results
@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation.Services
@using Gym.WebApplication.Features.Admin.Shared.Models
@using Gym.WebApplication.Features.Admin.Shared.Services
@using Gym.WebApplication.Features._Common.Services

@inject IRequestHandler<CreateCalendarEventFormModel, CreateCalendarEventResult> CreateCalendarEventService
@inject IRequestHandler<GetAllInstructors, IEnumerable<InstructorViewModel>> GetAllInstructorsService
@inject IRequestHandler<GetAllTrainings, IEnumerable<TrainingViewModel>> GetAllTrainingsService
@inject IDialogService DialogService

<EditForm Model="@_formModel" OnValidSubmit="@OnValidSubmit">
    
    <DataAnnotationsValidator />
    
    <MudGrid>
        <MudItem xs="12" sm="12">
            <MudCard Elevation="0">
                <MudCardContent>
                    <MudDatePicker PickerVariant="PickerVariant.Dialog" HelperText="Choose day" AutoClose="true"    
                                   MinDate="@DateTime.Today" @bind-Date="@_formModel.LocalStartDateTime" For="@(() => _formModel.LocalStartDateTime)"/>

                    <MudTimePicker PickerVariant="PickerVariant.Dialog" HelperText="Choose time" AutoClose="true" 
                                   @bind-Time="@_formModel.StartTimeSpan" For="@(() => _formModel.StartTimeSpan)" />
                    
                    <MudNumericField @bind-Value="@_formModel.DurationInMinutes" HelperText="Choose duration in minutes" Variant="Variant.Text"
                                   Step="30" For="@(() => _formModel.DurationInMinutes)" />

                    <MudSelect T="String" @bind-Value="@_formModel.TrainingId" Clearable="true" HelperText="Choose training" For="@(() => _formModel.TrainingId)">
                        @foreach (var training in _trainings)
                        {
                            <MudSelectItem T="String" Value="@training.Id">
                                @training.Name
                            </MudSelectItem>    
                        }
                    </MudSelect>

                    <MudNumericField @bind-Value="@_formModel.MaxClientCount" HelperText="Max client count" Variant="Variant.Text"
                                     Step="1" Min="0" For="@(() => _formModel.MaxClientCount)" />

                    <MudSelect T="String"
                               MultiSelection="true"
                               @bind-SelectedValues="@_formModel.Instructors"
                               Clearable="true"
                               HelperText="Choose instructors"
                               MultiSelectionTextFunc="@(new Func<IReadOnlyList<String>, String>(GetMultiSelectionText))">
                        @foreach (var instructor in _instructors)
                        {
                            <MudSelectItem T="String" Value="@instructor.Id">
                                @instructor.FullName
                            </MudSelectItem>
                        }
                    </MudSelect>

                </MudCardContent>

                <MudCardActions>
                    <MudStack Row="true" Class="ml-auto">
                        <MudCheckBox Disabled="true" ReadOnly="true" @bind-Value="@_pollAdded" />
                        @if (_pollAdded is false)
                        {
                            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Tertiary" OnClick="@CallAddPollDialog">Add poll</MudButton>
                        }
                        else
                        {
                            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Error" OnClick="@ResetPoll">Reset poll</MudButton>
                        }                        
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Create</MudButton>
                    </MudStack>
                  
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private CreateCalendarEventFormModel _formModel = new();

    private Boolean _pollAdded = false;

    private IList<TrainingViewModel> _trainings = [];
    private IList<InstructorViewModel> _instructors = [];

    protected override async Task OnInitializedAsync()
    {
        await this.LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var getAllTrainingsResult = await GetAllTrainingsService.HandleAsync(new GetAllTrainings());
        if (getAllTrainingsResult.Succeeded)
            _trainings = [.. getAllTrainingsResult.Data!];

        var getAllInstructorsResult = await GetAllInstructorsService.HandleAsync(new GetAllInstructors());
        if (getAllInstructorsResult.Succeeded)
            _instructors = [.. getAllInstructorsResult.Data!];
    }

    private String GetMultiSelectionText(IReadOnlyList<String> selectedValues)
    {
        return String.Join(
            ", ",
           _instructors.Where(anInstructor => selectedValues.Contains(anInstructor.Id)).Select(anInstructor => anInstructor.FullName)
        );
    }

    private async void ResetPoll()
    {
        _pollAdded = false;
        _formModel.PollFormModel = null;

        base.StateHasChanged();
    }

    private async void CallAddPollDialog()
    {

        var parameters = new DialogParameters<CreatePollDialog> { };
        if (_formModel.PollFormModel is not null)
            parameters.Add(x => x.FormModel, _formModel.PollFormModel);

        var dialog = await DialogService.ShowAsync<CreatePollDialog>("Create poll", parameters);
        var result = await dialog.Result;

        if(result is not null && result.Canceled is false)
        {
            if (result.Data is CreatePollFormModel createPollFormModel)
            {
                _pollAdded = true;
                _formModel.PollFormModel = createPollFormModel;
            }
        }

        base.StateHasChanged();
    }

    private async void OnValidSubmit(EditContext context)
    {
        var createCalendarEventResult = await CreateCalendarEventService.HandleAsync(_formModel);
        if (createCalendarEventResult.Succeeded)
        {
            this.ClearForm();
        }

    }

    private void ClearForm()
    {
        _formModel = new();
        base.StateHasChanged();
    }
}
