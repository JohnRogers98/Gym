@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation
@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation.Models.Results
@using Gym.WebApplication.Features.Admin.CalendarEvents.States

@inject ISnackbar Snackbar
@inject ICalendarEventCreationState CalendarEventCreationState

<MudExpansionPanel Text="Create calendar event form">
    <CreateCalendarEventForm></CreateCalendarEventForm>
</MudExpansionPanel>

@code {
    protected override async Task OnInitializedAsync()
    {
        CalendarEventCreationState.CalendarEventCreated += ShowCreatedCalendarEventInSnackbar;
    }

    private void ShowCreatedCalendarEventInSnackbar(CreateCalendarEventResult createCalendarEventResult)
    {
        Snackbar.Add($"Calendar event - {createCalendarEventResult.CalendarEventId} created", Severity.Success);
    }

    public void Dispose() => CalendarEventCreationState.CalendarEventCreated -= ShowCreatedCalendarEventInSnackbar;
}
