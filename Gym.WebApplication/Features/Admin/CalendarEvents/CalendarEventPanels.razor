@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation
@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation.Models.Forms
@using Gym.WebApplication.Features.Admin.CalendarEvents.Creation.Models.Results
@using Gym.WebApplication.Features.Admin.CalendarEvents.TableView
@using Gym.WebApplication.Features.Admin.CalendarEvents.TableView.Models
@using Gym.WebApplication.Features._Common.States
@using Gym.WebApplication.Operations

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<CreateCalendarEventFormModel, CreateCalendarEventResult> CreateCalendarEventState
@inject AsyncOperationStateNotifier<CancelCalendarEvent, CancelCalendarEventResult> CancelCalendarEventState


@implements IDisposable

<MudExpansionPanel Text="Create calendar event form">
    <CreateCalendarEventForm></CreateCalendarEventForm>
</MudExpansionPanel>

<MudExpansionPanel Text="Current calendar events">
    <CalendarEventTableView></CalendarEventTableView>
</MudExpansionPanel>

@code {
    protected override async Task OnInitializedAsync()
    {
        CreateCalendarEventState.Executed += ShowCreatedCalendarEventInSnackbar;
        CancelCalendarEventState.Executed += ShowCancelledCalendarEventInSnackbar;
    }

    private void ShowCreatedCalendarEventInSnackbar(AsyncOperation<CreateCalendarEventResult> createCalendarEventResult)
    {
        SnackbarNotifier.ShowMessage($"Calendar event - {createCalendarEventResult.Data!.CalendarEventId} created.", MessageSeverity.Success);
    }

    private void ShowCancelledCalendarEventInSnackbar(AsyncOperation<CancelCalendarEventResult> cancelCalendarEventResult)
    {
        SnackbarNotifier.ShowMessage($"Calendar event was cancelled.", MessageSeverity.Success);
    }

    public void Dispose()
    {
        CreateCalendarEventState.Executed -= ShowCreatedCalendarEventInSnackbar;
        CancelCalendarEventState.Executed -= ShowCancelledCalendarEventInSnackbar;
    }
}
