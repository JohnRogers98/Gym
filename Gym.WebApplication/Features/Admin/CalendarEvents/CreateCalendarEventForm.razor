@using Gym.WebApplication.Features._Common.Services

@inject IRequestHandler<CreateCalendarEventFormModel, CreateCalendarEventResult> CreateCalendarEventService
@inject IRequestHandler<ListInstructors, IEnumerable<InstructorViewModel>> GetAllInstructorsService
@inject IRequestHandler<ListTrainings, IEnumerable<TrainingViewModel>> GetAllTrainingsService

@inject IDialogService DialogService

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<CreateCalendarEventFormModel, CreateCalendarEventResult> CreateCalendarEventState

@implements IDisposable

<EditForm Model="@_formModel" OnSubmit="@OnSubmit">
    
    <FluentValidator />
    
    <MudGrid>
        <MudItem xs="12" sm="12">
            <MudCard Elevation="0">
                <MudCardContent>
                    <MudDatePicker Label="Choose day"
                        Variant="Variant.Outlined"
                        PickerVariant="PickerVariant.Dialog" 
                        AutoClose="true"           
                        MinDate="@DateTime.Today" 
                        @bind-Date="@_formModel.LocalStartDateTime" 
                        For="@(() => _formModel.LocalStartDateTime)"/>

                    <MudTimePicker Label="Choose time"
                        Variant="Variant.Outlined"
                        PickerVariant="PickerVariant.Dialog"
                        AutoClose="true"           
                        @bind-Time="@_formModel.StartTimeSpan"
                        For="@(() => _formModel.StartTimeSpan)" />
                    
                    <MudNumericField Label="Choose duration in minutes" 
                        @bind-Value="@_formModel.DurationInMinutes" 
                        Variant="Variant.Outlined"
                        Step="30" 
                        For="@(() => _formModel.DurationInMinutes)" />

                    <MudSelect T="String" 
                        Label="Choose training"
                        Variant="Variant.Outlined"
                        @bind-Value="@_formModel.TrainingId" 
                        Clearable="true" 
                        For="@(() => _formModel.TrainingId)">
                        @foreach (var training in _trainings)
                        {
                            <MudSelectItem T="String" Value="@training.Id">
                                @training.Name
                            </MudSelectItem>    
                        }
                    </MudSelect>

                    <MudNumericField Label="Max client count" 
                        @bind-Value="@_formModel.MaxClientCount" 
                        Variant="Variant.Outlined"             
                        Step="1" 
                        Min="0" 
                        For="@(() => _formModel.MaxClientCount)" />

                    <MudSelect T="String"
                        Variant="Variant.Outlined"
                               MultiSelection="true"
                               @bind-SelectedValues="@_formModel.Instructors"
                               Clearable="true"
                               Label="Choose instructors"
                               MultiSelectionTextFunc="@(new Func<IReadOnlyList<String>, String>(GetMultiSelectionText))">
                        @foreach (var instructor in _instructors)
                        {
                            <MudSelectItem T="String" Value="@instructor.Id">
                                @instructor.FullName
                            </MudSelectItem>
                        }
                    </MudSelect>

                </MudCardContent>

                <MudCardActions>
                    <MudStack Row="true" Class="ml-auto">
                        <MudCheckBox Disabled="true" ReadOnly="true" @bind-Value="@_pollAdded" />
                        @if (_pollAdded is false)
                        {
                            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Tertiary" OnClick="@CallAddPollDialog">Add poll</MudButton>
                        }
                        else
                        {
                            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Error" OnClick="@ResetPoll">Reset poll</MudButton>
                        }                        
                        <MudButton ButtonType="ButtonType.Submit" Disabled="@_isSubmitting" Variant="Variant.Filled" Color="Color.Primary">
                            @(_isSubmitting ? "Creating..." : "Create")
                        </MudButton>
                    </MudStack>
                  
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private CreateCalendarEventFormModel _formModel = new();

    private Boolean _isSubmitting;

    private Boolean _pollAdded = false;

    private IList<TrainingViewModel> _trainings = [];
    private IList<InstructorViewModel> _instructors = [];

    protected override async Task OnInitializedAsync()
    {
        CreateCalendarEventState.Executed += ShowCreatedCalendarEventInSnackbar;
        await this.LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var getAllTrainingsResult = await GetAllTrainingsService.HandleAsync(new ListTrainings());
        if (getAllTrainingsResult.Succeeded)
            _trainings = [.. getAllTrainingsResult.Data!];

        var getAllInstructorsResult = await GetAllInstructorsService.HandleAsync(new ListInstructors());
        if (getAllInstructorsResult.Succeeded)
            _instructors = [.. getAllInstructorsResult.Data!];
    }

    private String GetMultiSelectionText(IReadOnlyList<String> selectedValues)
    {
        return String.Join(
            ", ",
           _instructors.Where(anInstructor => selectedValues.Contains(anInstructor.Id)).Select(anInstructor => anInstructor.FullName)
        );
    }

    private void ResetPoll()
    {
        _pollAdded = false;
        _formModel.PollFormModel = null;

        base.StateHasChanged();
    }

    private async Task CallAddPollDialog()
    {

        var parameters = new DialogParameters<CreatePollDialog> { };
        if (_formModel.PollFormModel is not null)
            parameters.Add(x => x.FormModel, _formModel.PollFormModel);

        var dialog = await DialogService.ShowAsync<CreatePollDialog>("Create poll", parameters);
        var result = await dialog.Result;

        if(result is not null && result.Canceled is false)
        {
            if (result.Data is CreatePollFormModel createPollFormModel)
            {
                _pollAdded = true;
                _formModel.PollFormModel = createPollFormModel;
            }
        }

        base.StateHasChanged();
    }

    private async Task OnSubmit(EditContext context)
    {
        var isValid = await context.ValidateAsync();
        if (isValid)
        {
            await this.CreateCalendarEventAsync();
        }
    }

    private async Task CreateCalendarEventAsync()
    {
        //guard
        if (_isSubmitting) return;

        _isSubmitting = true;
        base.StateHasChanged();

        try
        {
            var createCalendarEventResult = await CreateCalendarEventService.HandleAsync(_formModel);
            if (createCalendarEventResult.Succeeded)
            {
                this.ClearForm();
            }
        }
        finally
        {
            _isSubmitting = false;
            base.StateHasChanged();
        }
    }

    private void ClearForm()
    {
        _formModel = new();
        base.StateHasChanged();
    }

    private void ShowCreatedCalendarEventInSnackbar(AsyncOperation<CreateCalendarEventResult> createCalendarEventResult)
    {
        SnackbarNotifier.ShowMessage($"Calendar event - {createCalendarEventResult.Data!.CalendarEventId} created.", MessageSeverity.Success);
    }

    public void Dispose()
    {
        CreateCalendarEventState.Executed -= ShowCreatedCalendarEventInSnackbar;
    }
}
