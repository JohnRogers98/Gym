@using Gym.WebApplication.BffRequestHandlers

@inject IRequestHandler<ListUserRoles, ListUserRolesResult> ListUserRolesService
@inject IRequestHandler<CreateClientFormModel, CreateClientResult> CreateClientService

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<CreateClientFormModel, CreateClientResult> CreateClientState

@inject IDialogService DialogService

@implements IDisposable

<EditForm Model="@_formModel" OnSubmit="@OnSubmit">

    <FluentValidator AsyncMode="true" />

    <div style="display:none; position:absolute; opacity:0; height:0; width:0; overflow:hidden;">
        <input type="text" name="fakeusername" autocomplete="username" />
        <input type="password" name="fakepassword" autocomplete="current-password" />
    </div>
    
    <MudGrid>
        <MudItem xs="12" sm="12">
            <MudCard Elevation="0">
                <MudCardContent>
                    <MudTextField Label="Client username"
                                  Variant="Variant.Outlined"
                                  @bind-Value="@_formModel.Username"
                                  For="@(() => _formModel.Username)" />

                    <MudPasswordField Label="Client password"
                                      Variant="Variant.Outlined"
                                      @bind-Value="@_formModel.Password"
                                      PasswordMode="true"
                                      DisablePaste="false"
                                      For="@(() => _formModel.Password)" />

                    <MudTextField Label="First name"
                                  Variant="Variant.Outlined"
                                  Class="mt-3"
                                  @bind-Value="_formModel.FirstName"
                                  For="@(() => _formModel.FirstName)" />

                    <MudTextField Label="Last name"
                                  Variant="Variant.Outlined"
                                  Class="mt-3"
                                  @bind-Value="_formModel.LastName"
                                  For="@(() => _formModel.LastName)" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Disabled="@_isSubmitting" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">
                        @(_isSubmitting ? "Creating..." : "Create")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private CreateClientFormModel _formModel = new();

    private const String ClientRoleName = "Client"; 
    private UserRole? _clientRole;

    private Boolean _isSubmitting;


    protected async override Task OnInitializedAsync()
    {
        CreateClientState.Executed += this.ShowInSnackbar;
        await this.LoadClientRoleAsync();
    }

    private async Task LoadClientRoleAsync()
    {
        var listUserRolesResult = await ListUserRolesService.HandleAsync(new ListUserRoles());
        if (listUserRolesResult.Succeeded)
        {
            _clientRole = listUserRolesResult.Data.Roles.First(role => role.Name == ClientRoleName);
        }
    }

    private async Task OnSubmit(EditContext context)
    {
        if (_clientRole == null)
            await LoadClientRoleAsync();
        _formModel.RoleId = _clientRole?.Id;

        var isValid = await context.ValidateAsync();
        if (isValid)
        {
            await this.CreateClientAsync();
        }
    }
    private async Task CreateClientAsync()
    {
        //guard
        if (_isSubmitting) return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var createClientResult = await CreateClientService.HandleAsync(_formModel);
            if (createClientResult.Succeeded)
            {
                this.ClearForm();
            }
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
    private void ClearForm()
    {
        _formModel = new();
        base.StateHasChanged();
    }

    private void ShowInSnackbar(AsyncOperation<CreateClientResult> accountChargingResult)
    {
        if (accountChargingResult.Succeeded)
        {
            SnackbarNotifier.ShowMessage($"Client created.", MessageSeverity.Success);
        }
    }

    public void Dispose() => CreateClientState.Executed -= this.ShowInSnackbar;

}
