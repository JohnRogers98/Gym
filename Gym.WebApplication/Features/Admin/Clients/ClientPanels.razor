@using Gym.WebApplication.Features.Admin.Clients.Creation
@using Gym.WebApplication.Features.Admin.Clients.TableView
@using Gym.WebApplication.Features.Admin.Clients.TableView.Models.Forms
@using Gym.WebApplication.Features.Admin.Clients.TableView.Models.Results
@using Gym.WebApplication.Features._Common.States
@using Gym.WebApplication.Operations

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<ChargeClientFormModel, ChargeClientResult> ClientChargingState

@implements IDisposable

<MudExpansionPanel Text="Current clients">
    <ClientTableView></ClientTableView>
</MudExpansionPanel>

<MudExpansionPanel Text="Register client">
    <ClientCreationForm></ClientCreationForm>
</MudExpansionPanel>

@code {

    protected override async Task OnInitializedAsync()
    {
        ClientChargingState.Executed += ShowAccountChargingInSnackbar;
    }

    private void ShowAccountChargingInSnackbar(AsyncOperation<ChargeClientResult> accountChargingResult)
    {
        if (accountChargingResult.Succeeded)
        {
            SnackbarNotifier.ShowMessage($"Client account has - {accountChargingResult.Data!.AvailableTrainingsCount} available trainings.", MessageSeverity.Success);
        }
    }

    public void Dispose() => ClientChargingState.Executed -= ShowAccountChargingInSnackbar;
}
