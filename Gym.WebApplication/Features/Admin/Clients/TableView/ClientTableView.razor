@using Gym.WebApplication.Features.Admin.Clients.TableView.Models.Forms
@using Gym.WebApplication.Features.Admin.Clients.TableView.Services


@inject IGetAllClientsService GetAllClientsService
@inject IChargeClientService ChargeClientService

@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDataGrid T="ClientViewModel" Items="@_clients" Striped="true" Elevation="0">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="Id" />
        <PropertyColumn Property="x => x.FullName" Title="Full name" />
        <PropertyColumn Property="x => x.AvailableTrainingsCount" Title="Available trainings" />

        <TemplateColumn Title="Actions" CellClass="d-flex justify-between">
            <CellTemplate>
                <MudIconButton Size="@Size.Medium" Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" OnClick="@(() => ChargeClient(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private List<ClientViewModel> _clients = new();

    protected override async Task OnInitializedAsync()
    {
        _clients = [.. await GetAllClientsService.ExecuteAsync()];
    }

    private async void ChargeClient(ClientViewModel clientViewModel)
    {
        var parameters = new DialogParameters<ClientChargingDialog> { { x => x.ClientViewModel, clientViewModel } };

        var dialog = await DialogService.ShowAsync<ClientChargingDialog>("Client charging", parameters);
        var result = await dialog.Result;

        if (result is not null && result.Canceled is false)
        {
            if (result.Data is ChargeClientFormModel chargeClientFormModel)
            {
                var chargeClientResult = await ChargeClientService.HandleAsync(chargeClientFormModel);

                Snackbar.Add($"Client account is {chargeClientResult.AvailableTrainingsCount}", Severity.Info);

                _clients = _clients
                    .Select(aClient => aClient.Id == chargeClientFormModel.ClientId ? aClient with { AvailableTrainingsCount = chargeClientResult.AvailableTrainingsCount } : aClient)
                    .ToList();

                base.StateHasChanged();
            }

        }
    }
}
