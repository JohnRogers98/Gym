@using Gym.WebApplication.Features.Admin.Clients.TableView.Models.Forms

<MudDialog>
     
    <DialogContent>
        <EditForm @ref="_editForm" Model="@_formModel" OnValidSubmit="@ApproveAction">
            <DataAnnotationsValidator />

            <MudNumericField @bind-Value="@_formModel.ByCount" HelperText="By count" Variant="Variant.Outlined" HideSpinButtons="true" For="@(() => @_formModel.ByCount)" />
        </EditForm>
      
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelAction">Cancel</MudButton>
        <MudButton Color="Color.Success" OnClick="@ApproveAction">Charge</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .my-custom-class {
        backdrop-filter: blur(10px);
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private EditForm _editForm = default!;

    [Parameter, EditorRequired] public ClientViewModel ClientViewModel { get; set; }

    private ChargeClientFormModel _formModel = new ChargeClientFormModel();

    protected override async Task OnParametersSetAsync()
    {
        _formModel.ClientId = ClientViewModel.Id;
    }

    private void CancelAction() => MudDialog.Cancel();

    private void ApproveAction()
    {
        if (_editForm.EditContext?.Validate() is true)
        {
            MudDialog.Close(DialogResult.Ok<ChargeClientFormModel>(_formModel));
        }
    }
}
