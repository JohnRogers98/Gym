@using Gym.WebApplication.Features._Common.Services


@inject IRequestHandler<ListClientsForAdmin, IEnumerable<ClientViewModel>> ListClientsService
@inject IRequestHandler<ChargeClientFormModel, ChargeClientResult> ChargeClientService

@inject IDialogService DialogService

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<ChargeClientFormModel, ChargeClientResult> ClientChargingState

@implements IDisposable


<MudDataGrid T="ClientViewModel" Items="@_clients" Striped="true" Elevation="0">

    <ToolBarContent>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       OnClick="@RefreshDataAsync"
                       Size="Size.Small" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="Id" />
        <PropertyColumn Property="x => x.FullName" Title="Full name" />
        <PropertyColumn Property="x => x.AvailableTrainingsCount" Title="Available trainings" />

        <TemplateColumn Title="Actions" CellClass="d-flex justify-between">
            <CellTemplate>
                <MudIconButton Size="@Size.Medium" Icon="@Icons.Material.Filled.AddCircle" Color="Color.Primary" OnClick="@(() => ChargeClientAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private List<ClientViewModel> _clients = new();

    protected override async Task OnInitializedAsync()
    {
        ClientChargingState.Executed += ShowAccountChargingInSnackbar;
        await this.LoadDataAsync();
    }

    private async Task ChargeClientAsync(ClientViewModel clientViewModel)
    {
        var parameters = new DialogParameters<ClientChargingDialog> { { x => x.ClientViewModel, clientViewModel } };

        var dialog = await DialogService.ShowAsync<ClientChargingDialog>("Client charging", parameters);
        var result = await dialog.Result;

        if (result is not null && result.Canceled is false)
        {
            if (result.Data is ChargeClientFormModel chargeClientFormModel)
            {
                var chargeClientResult = await ChargeClientService.HandleAsync(chargeClientFormModel);
                if (chargeClientResult.Succeeded)
                {
                    await this.RefreshDataAsync();
                }
            }
        }
    }

    private async Task RefreshDataAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        var getAllClientsResult = await ListClientsService.HandleAsync(new ListClientsForAdmin());
        if (getAllClientsResult.Succeeded)
        {
            _clients = getAllClientsResult.Data!.ToList();
        }
    }

    private void ShowAccountChargingInSnackbar(AsyncOperation<ChargeClientResult> accountChargingResult)
    {
        if (accountChargingResult.Succeeded)
        {
            SnackbarNotifier.ShowMessage($"Client account has - {accountChargingResult.Data!.AvailableTrainingsCount} available trainings.", MessageSeverity.Success);
        }
    }

    public void Dispose() => ClientChargingState.Executed -= ShowAccountChargingInSnackbar;

}
