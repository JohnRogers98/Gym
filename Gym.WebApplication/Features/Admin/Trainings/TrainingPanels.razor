@using Gym.WebApplication.Features.Admin.Trainings.Creation
@using Gym.WebApplication.Features.Admin.Trainings.Creation.Models.Results
@using Gym.WebApplication.Features.Admin.Trainings.States
@using Gym.WebApplication.Features.Admin.Trainings.TableView

@inject ISnackbar Snackbar
@inject ITrainingCreationSharedState TrainingCreationSharedState

<MudExpansionPanel Text="Create training form">
    <CreateTrainingForm></CreateTrainingForm>
</MudExpansionPanel>

<MudExpansionPanel Text="Current trainigs">
    <TrainingTableView></TrainingTableView>
</MudExpansionPanel>

@code {

    protected override async Task OnInitializedAsync()
    {
        TrainingCreationSharedState.TrainingCreated += ShowRegisteredInstructorInSnackbar;
    }

    private void ShowRegisteredInstructorInSnackbar(CreateTrainingResult createTrainingResult)
    {
        Snackbar.Add($"Training - {createTrainingResult.TrainingId} created", Severity.Success);
    }

}
