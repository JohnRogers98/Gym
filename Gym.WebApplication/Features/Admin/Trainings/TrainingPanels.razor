@using Gym.WebApplication.Features.Admin.Trainings.Creation
@using Gym.WebApplication.Features.Admin.Trainings.Creation.Models.Forms
@using Gym.WebApplication.Features.Admin.Trainings.Creation.Models.Results
@using Gym.WebApplication.Features.Admin.Trainings.TableView
@using Gym.WebApplication.Features._Common.States
@using Gym.WebApplication.Operations

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<CreateTrainingFormModel ,CreateTrainingResult> CreateTrainingState

@implements IDisposable

<MudExpansionPanel Text="Create training form">
    <CreateTrainingForm></CreateTrainingForm>
</MudExpansionPanel>

<MudExpansionPanel Text="Current trainigs">
    <TrainingTableView></TrainingTableView>
</MudExpansionPanel>

@code {

    protected override async Task OnInitializedAsync()
    {
        CreateTrainingState.Executed += ShowRegisteredTrainingInSnackbar;
    }

    private void ShowRegisteredTrainingInSnackbar(AsyncOperation<CreateTrainingResult> createTrainingResult)
    {
        if (createTrainingResult.Succeeded)
        {
            SnackbarNotifier.ShowMessage($"Training - {createTrainingResult.Data!.TrainingId} created", MessageSeverity.Success);
        }
    }

    public void Dispose() => CreateTrainingState.Executed -= ShowRegisteredTrainingInSnackbar;
}
