@using Gym.WebApplication.Features._Common.Services

@inject IRequestHandler<ListTrainings, IEnumerable<TrainingViewModel>> GetAllTrainingsService

<MudDataGrid Items="@_trainings" Striped="true" Elevation="0">

    <ToolBarContent>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       OnClick="@RefreshDataAsync"
                       Size="Size.Small" />
    </ToolBarContent>

    <Columns>
        <PropertyColumn Property="x => x.Id" Title="Id" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Description" Title="Description" />
    </Columns>
</MudDataGrid>

@code {
    private IList<TrainingViewModel> _trainings = new List<TrainingViewModel>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task RefreshDataAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        var getAllTrainingsResult = await GetAllTrainingsService.HandleAsync(new ListTrainings());
        if (getAllTrainingsResult.Succeeded)
        {
            _trainings = getAllTrainingsResult.Data!.ToList();
        }
    }

}
