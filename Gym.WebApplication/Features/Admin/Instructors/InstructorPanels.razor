@using Gym.WebApplication.Features.Admin.Instructors.Registration
@using Gym.WebApplication.Features.Admin.Instructors.Registration.Models.Forms
@using Gym.WebApplication.Features.Admin.Instructors.Registration.Models.Results
@using Gym.WebApplication.Features.Admin.Instructors.TableView
@using Gym.WebApplication.Features._Common.States
@using Gym.WebApplication.Operations

@inject IAppSnackbarNotifier SnackbarNotifier
@inject AsyncOperationStateNotifier<InstructorRegistrationFormModel, CreateInstructorResult> InstructorRegistrationState

@implements IDisposable

<MudExpansionPanel Text="Instructor registration form">
    <InstructorRegistration></InstructorRegistration>
</MudExpansionPanel>

<MudExpansionPanel Text="Current instructors">
    <InstructorTableView></InstructorTableView>
</MudExpansionPanel>

@code {

    protected override async Task OnInitializedAsync()
    {
        InstructorRegistrationState.Executed += ShowRegisteredInstructorInSnackbar;
    }

    private void ShowRegisteredInstructorInSnackbar(AsyncOperation<CreateInstructorResult> instructorRegistrationResult)
    {
        if (instructorRegistrationResult.Succeeded)
        {
            SnackbarNotifier.ShowMessage($"Instructor - {instructorRegistrationResult.Data!.InstructorId} created", MessageSeverity.Success);
        }
    }

    public void Dispose() => InstructorRegistrationState.Executed -= ShowRegisteredInstructorInSnackbar;
}
