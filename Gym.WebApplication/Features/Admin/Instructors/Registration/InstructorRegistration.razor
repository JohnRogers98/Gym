@using Gym.WebApplication.Features.Admin.Instructors.Registration.Models.Forms
@using Gym.WebApplication.Features.Admin.Instructors.Registration.Models.Results
@using Gym.WebApplication.Features.Admin.Instructors.Registration.Services
@using Gym.WebApplication.Features.Admin.Instructors.States

@inject ICreateInstructorService CreateInstructorService
@inject IInstructorRegisteredSharedState InstructorRegisteredSharedState

@inject IDialogService DialogService

<EditForm Model="@_formModel" OnValidSubmit="@OnValidSubmit">
    <DataAnnotationsValidator />
    <MudGrid>
        <MudItem xs="12" sm="12">
            <MudCard Elevation="0">
                <MudCardContent>
                    <MudTextField HelperText="Enter login" Class="mt-3" @bind-Value="_formModel.Login" For="@(() => _formModel.Login)" />
                    <MudTextField HelperText="Enter first name" @bind-Value="@_formModel.FirstName" For="@(() => _formModel.FirstName)" />
                    <MudTextField HelperText="Enter last name" Class="mt-3" @bind-Value="_formModel.LastName" For="@(() => _formModel.LastName)" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Register</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private InstructorRegistrationFormModel _formModel = new InstructorRegistrationFormModel();

    protected override async Task OnInitializedAsync() { }

    private async void OnValidSubmit(EditContext context)
    {
        CreateInstructorResult createInstructorResult = await CreateInstructorService.HandleAsync(_formModel);
        InstructorRegisteredSharedState.Notify(createInstructorResult);

        var parameters = new DialogParameters<ShowCreatedInstructorCredentialsDialog> { { x => x.CreateInstructorResult, createInstructorResult } };
        var dialog = await DialogService.ShowAsync<ShowCreatedInstructorCredentialsDialog>("Instructor credentials", parameters);

        this.ClearForm();
    }

    private void ClearForm()
    {
        _formModel = new InstructorRegistrationFormModel();
        base.StateHasChanged();
    }
}
