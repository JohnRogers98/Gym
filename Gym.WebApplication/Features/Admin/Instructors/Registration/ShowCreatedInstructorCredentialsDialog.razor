@using Gym.WebApplication.Features.Admin.Instructors.Registration.Models.Results

<MudDialog>
    <DialogContent>
        <MudStack Spacing="1">
            <MudAlert Severity="Severity.Info">Login: @CreateInstructorResult.Login</MudAlert>
            <MudAlert Severity="Severity.Info">Password: @CreateInstructorResult.Password</MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success" OnClick="@ApproveAction">Ok</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .my-custom-class {
        backdrop-filter: blur(10px);
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public CreateInstructorResult CreateInstructorResult { get; set; }

    private void ApproveAction()
    {
        MudDialog.Close();
    }
}
