@using Gym.WebApplication.Features.Admin.Instructors.Registration.Models.Results
@using Gym.WebApplication.Features.Admin.Instructors.States
@using Gym.WebApplication.Features.Admin.Shared.Services
@using Gym.WebApplication.Features.Admin.Shared.ValueObjects
@using Polly
@using Polly.Retry

@inject IGetAllInstructorsService GetAllInstructorsService  
@inject IGetInstructorByIdService GetInstructorByIdService
@inject IInstructorRegisteredSharedState InstructorRegisteredSharedState


<MudDataGrid Items="@_instructors" Striped="true" Elevation="0">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="Id" />
        <PropertyColumn Property="x => x.FullName" Title="FullName" />
    </Columns>
</MudDataGrid>

@code {
    private IList<InstructorViewModel> _instructors = new List<InstructorViewModel>();

    protected override async Task OnInitializedAsync()
    {
        InstructorRegisteredSharedState.InstructorCreated += AddCreatedInstructor;
        _instructors = [.. await GetAllInstructorsService.HandleAsync()];
    }

    private async void AddCreatedInstructor(CreateInstructorResult createdInstructorViewModel)
    {
        InstructorId instructorId = new InstructorId(createdInstructorViewModel.InstructorId);
        InstructorViewModel? instructorViewModel = await GetInstructorByIdService.HandleAsync(instructorId);

        if (instructorViewModel is null)
            return;

        _instructors.Add(instructorViewModel);
        base.StateHasChanged();
    }
}
