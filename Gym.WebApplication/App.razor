<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Features.NotFound.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView  RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <MudAlert Severity="Severity.Error">Not authorized</MudAlert>
            </NotAuthorized>

            <Authorizing>
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
